# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True

# Database Configuration (for local development with Docker)
DB_NAME=halfnote_db
DB_USER=halfnote_user
DB_PASSWORD=halfnote_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (optional - improves performance)
REDIS_URL=redis://localhost:6379/0

# Cloudinary Configuration (for image hosting)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Discogs API Configuration (for music data)
DISCOGS_CONSUMER_KEY=your-discogs-consumer-key
DISCOGS_CONSUMER_SECRET=your-discogs-consumer-secret
DISCOGS_TOKEN=your-discogs-token
