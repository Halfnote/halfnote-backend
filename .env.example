# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True

# Database Configuration (for local development with Docker)
DB_NAME=halfnote_db
DB_USER=halfnote_user
DB_PASSWORD=halfnote_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (optional - improves performance)
REDIS_URL=redis://localhost:6379/0

# Cloudinary Configuration (for image hosting)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Discogs API Configuration (for music data)
DISCOGS_CONSUMER_KEY=your-discogs-consumer-key
DISCOGS_CONSUMER_SECRET=your-discogs-consumer-secret
DISCOGS_TOKEN=your-discogs-token

# Sign in with Apple (APPLE_PRIVATE_KEY is the .p8 contents, newlines as \n)
APPLE_BUNDLE_ID=com.example.halfnote
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=
# Comma-separated Google OAuth client IDs (iOS, plus web if used)
GOOGLE_CLIENT_IDS=
